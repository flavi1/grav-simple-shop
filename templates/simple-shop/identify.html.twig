{# templates/simple-shop/identify.html.twig #}
{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="shop-container identify-page">
    <h2>Connexion par e-mail</h2>

    {% if action != 'verify_otp' %}
        {# ÉTAPE 1 : Saisie de l'e-mail pour recevoir l'OTP #}
        <p>Saisissez votre adresse e-mail pour recevoir un code de connexion sécurisé à usage unique (OTP).</p>

        <form method="POST" action="{{ uri.route() }}" class="shop-form">
            <input type="hidden" name="action" value="request_otp" />
            <input type="hidden" name="back_url" value="{{ back_url }}" />
            {{ nonce_field('shop-identify', 'nonce')|raw }}

            <div class="form-group">
                <label for="email">Adresse e-mail</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="vous@example.com" 
                    required 
                    autofocus
                    class="form-control"
                    autocomplete="email"
                    value="{{ customer.email|default('') }}"
                />
            </div>

            <div class="form-actions" style="margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    Recevoir mon code de connexion
                </button>
            </div>
        </form>

    {% else %}
        {# ÉTAPE 2 : Saisie du code OTP reçu par e-mail #}
        <p>Un code de validation a été envoyé à l'adresse : <strong>{{ customer.email }}</strong></p>

        <form method="POST" action="{{ uri.route() }}" class="shop-form">
            <input type="hidden" name="action" value="verify_otp" />
            <input type="hidden" name="back_url" value="{{ back_url }}" />
            {{ nonce_field('shop-identify', 'nonce')|raw }}

            <div class="form-group">
                <label for="verification_code">Code de sécurité à 6 chiffres</label>
                <input 
                    type="text" 
                    id="verification_code" 
                    name="verification_code" 
                    placeholder="123456" 
                    maxlength="6"
                    required 
                    autofocus
                    class="form-control"
                    autocomplete="one-time-code"
                />
            </div>

            <div class="form-actions" style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
                <button type="submit" class="btn btn-primary">
                    Valider le code
                </button>
                <a href="{{ uri.route() }}?back_url={{ back_url|url_encode }}" class="btn btn-link" style="font-size: 0.9rem;">
                    Modifier l'e-mail
                </a>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
