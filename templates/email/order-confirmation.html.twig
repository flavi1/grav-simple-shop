{#
    templates/email/order-confirmation.html.twig

    Template de l'e-mail de confirmation de commande, envoyé au CLIENT par
    OrderMailer::sendOrderConfirmation() lorsque le panier est transformé en
    commande (CartController::step3Payment(), après CartStorage::toOrder()).

    Variables attendues (voir OrderMailer::buildOrderVars()) :
      - site_name       (string) Nom du site (site.title).
      - order_reference (string) Référence de la commande.
      - order_date      (string) Date de création (telle que stockée en base).
      - order_total     (float)  Montant total TTC (articles + livraison).
      - customer        (array)  Données client décodées (customer_data).
      - shipping        (array)  Données de livraison décodées (shipping_data),
                                  attendu au minimum : 'key', 'price'.
      - billing         (array)  Données de facturation décodées (billing_data).
      - order_items     (array)  Lignes de commande (order_item), chacune avec
                                  'title', 'price', 'quantity'.
#}
{% extends 'email/base.html.twig' %}

{% block content %}
<p>
    Bonjour {{ customer.firstname|default('') }} {{ customer.lastname|default('') }},
</p>

<p>
    Nous vous confirmons la bonne réception de votre commande
    <strong>{{ order_reference }}</strong>{% if order_date %} passée le {{ order_date }}{% endif %}.
</p>

<h3>Récapitulatif de votre commande</h3>
<table style="width: 100%; border-collapse: collapse;">
    <thead>
        <tr>
            <th style="text-align: left; border-bottom: 1px solid #ddd; padding: 4px;">Article</th>
            <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 4px;">Qté</th>
            <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 4px;">Prix unitaire</th>
            <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 4px;">Sous-total</th>
        </tr>
    </thead>
    <tbody>
        {% for item in order_items %}
            <tr>
                <td style="padding: 4px;">{{ item.title }} {% include 'partials/simple-shop/line-options.html.twig' with {'options': item.options} %}</td>
                <td style="text-align: right; padding: 4px;">{{ item.quantity }}</td>
                <td style="text-align: right; padding: 4px;">{{ item.price|number_format(2, ',', ' ') }} €</td>
                <td style="text-align: right; padding: 4px;">{{ (item.price * item.quantity)|number_format(2, ',', ' ') }} €</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<p style="text-align: right; font-weight: bold;">
    Total : {{ order_total|number_format(2, ',', ' ') }} €
</p>

<h3>Adresse de livraison</h3>
<p>
    {{ customer.firstname|default('') }} {{ customer.lastname|default('') }}<br>
    {{ customer['street']|default('') }}<br>
    {% if customer['address-complement']|default('') %}{{ customer['address-complement'] }}<br>{% endif %}
    {{ customer['postal-code']|default('') }} {{ customer['city']|default('') }}
</p>

{% if shipping.key is defined %}
    <p>
        Mode de livraison : {{ shipping.name|default(shipping.key) }}{% if shipping.price is defined %} ({{ shipping.price|number_format(2, ',', ' ') }} €){% endif %}
        {% if shipping.pickup_point is defined and shipping.pickup_point %}<br>Point de retrait : {{ shipping.pickup_point.name }}, {{ shipping.pickup_point.street }}, {{ shipping.pickup_point['postal-code'] }} {{ shipping.pickup_point.city }}{% endif %}
    </p>
{% endif %}

<h3>Adresse de facturation</h3>
<p>
    {{ billing.name|default('') }}<br>
    {{ billing['street']|default('') }}<br>
    {% if billing['address-complement']|default('') %}{{ billing['address-complement'] }}<br>{% endif %}
    {{ billing['postal-code']|default('') }} {{ billing['city']|default('') }}
</p>

<p>
    Merci pour votre confiance,<br>
    L'équipe {{ site_name }}
</p>
{% endblock %}

{% block footer %}
  <p style="text-align: center;">{{ site_name }} - Tous droits réservés</p>
{% endblock %}
